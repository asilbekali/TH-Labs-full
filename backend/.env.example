# Copy to .env to override defaults. All keys are prefixed TH_LABS_.

# demo (default, force simulation — safe everywhere) | auto (real models where
# installed; best on Python 3.11/3.12) | real (require models)
TH_LABS_MODE=auto

# STT · Whisper
TH_LABS_WHISPER_MODEL=medium
TH_LABS_WHISPER_DEVICE=auto
TH_LABS_WHISPER_COMPUTE_TYPE=auto

# NMT · NLLB-200
TH_LABS_NMT_MODEL=facebook/nllb-200-distilled-600M

# TTS · OmniVoice (zero-shot voice cloning via the `omnivoice` package)
TH_LABS_OMNIVOICE_MODEL=k2-fsa/OmniVoice
TH_LABS_OMNIVOICE_DEVICE=auto
TH_LABS_OMNIVOICE_REF_SECONDS=12

# Lip Sync · Wav2Lip (point to a local checkout with checkpoints/)
# TH_LABS_WAV2LIP_DIR=C:\models\Wav2Lip
