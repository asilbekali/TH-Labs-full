# # ── Core ────────────────────────────────────────────────────────────────────
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require"
# PORT=3001

# # ── Auth (JWT) ──────────────────────────────────────────────────────────────
# JWT_SECRET="change-me"
# JWT_EXPIRES_IN="15m"
# JWT_REFRESH_SECRET="change-me-too"
# JWT_REFRESH_EXPIRES_IN="30d"

# # ── Dubbing pipeline ────────────────────────────────────────────────────────
# # Origin of the FastAPI pipeline, probed by GET /v1/health so the Studio can
# # tell "pipeline asleep" apart from "API down". Optional — leave it unset and
# # health reports pipeline: "not_configured" instead of guessing.
# DUB_API_URL="http://46.224.138.121:8000"

# # ── Seed admin ──────────────────────────────────────────────────────────────
# SEED_ADMIN_EMAIL="admin@example.com"
# SEED_ADMIN_PASSWORD="change-me"

# # ── Billing / Lemon Squeezy ────────────────────────────────────────────────
# # The Studio's browser ORIGIN — scheme + host, nothing else. Also the base for
# # the Lemon Squeezy return URL (${APP_URL}/plans/success).
# APP_URL="http://localhost:5173"

# # Payments are Lemon Squeezy share links plus reads of the LS API. No webhook.
# #
# # How a purchase becomes credits:
# #   1. The Buy button opens the plan's share link with the account's email
# #      prefilled (that email is how the order is found again).
# #   2. The customer pays on lemonsqueezy.com.
# #   3. The API asks LS for the paid orders filed under that email and credits
# #      each new one, matched on the order's VARIANT id — once, keyed on the
# #      order id. It asks when the buyer returns to /plans/success, and every
# #      5 minutes for a day after a checkout was opened, so closing the tab
# #      loses nothing. Subscription renewals are polled hourly the same way.
# #
# # The links and variant ids live in the catalog (admin panel; the seed fills
# # the starting ones). Nothing to set here for them.
# #
# # Set each LS product's redirect / confirmation button link to
# # ${APP_URL}/plans/success so buyers come straight back. Optional — the cron
# # credits them anyway.
# #
# # LEMONSQUEEZY_API_KEY is the critical one: without it no purchase can be
# # verified, so Buy buttons 503 rather than taking money that cannot be
# # credited. Keys are per-mode — a TEST-mode key sees only test orders — so it
# # must match the mode of the links in the catalog (currently TEST mode).
# # LEMONSQUEEZY_STORE_ID is only needed if the key can see more than one store.
# LEMONSQUEEZY_API_KEY="eyJ0eXAiOiJKV1Qi..."
# LEMONSQUEEZY_STORE_ID=""
# # LEMONSQUEEZY_WEBHOOK_SECRET turns on POST /v1/payments/webhook, which credits a
# # purchase the instant LS marks it paid. Set the same secret on the webhook in
# # LS → Settings → Webhooks (URL: https://<api-host>/v1/payments/webhook).
# LEMONSQUEEZY_WEBHOOK_SECRET=""

# # ── Mail (SMTP / nodemailer) ────────────────────────────────────────────────
# # Optional: without MAIL_USER / MAIL_PASS the app still boots and MailService
# # logs every send instead of delivering it.
# # MAIL_PASS is a Gmail *App Password* (16 chars, no spaces), not the account
# # password — 2FA must be on to generate one.
# MAIL_HOST="smtp.gmail.com"
# MAIL_PORT=465
# MAIL_USER="thethlabs.io@gmail.com"
# MAIL_PASS="your-16-char-app-password"
# MAIL_FROM="TH Labs <thethlabs.io@gmail.com>"

# # ── Audit log (admin panel activity feed) ──────────────────────────────────
# # Record GET reads too. Off by default: polling would drown the feed.
# AUDIT_LOG_READS="false"
# # Days of history kept; a daily 3am cron prunes past this.
# AUDIT_LOG_RETENTION_DAYS=90

# ── Database transaction budget ────────────────────────────────────────────
# How long a Prisma interactive transaction may wait for a connection, and how
# long its body may run. Prisma's own defaults are 2000 / 5000, sized for a
# Postgres on localhost.
#
# They are too tight for a hosted database reached over the internet. Against
# Neon in us-east-1 one query round trip measures 200-430 ms, opening a FRESH
# connection measures ~3 s (TLS + channel binding + the Neon proxy, after an
# idle connection was closed or a scaled-to-zero compute woke), and the dub
# charge makes five sequential queries inside one transaction. The result was
# P2028 "Unable to start a transaction in the given time" from
# POST /v1/payments/commit-dub -- every dub failed, while /payments/can-dub
# kept answering because it opens no transaction.
#
# Lower them back toward the Prisma defaults for a database on the same host.
DB_TX_MAX_WAIT_MS=15000
DB_TX_TIMEOUT_MS=20000
