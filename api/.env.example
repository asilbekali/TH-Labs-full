# ── Core ────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:pass@host:5432/db?sslmode=require"
PORT=3001

# ── Auth (JWT) ──────────────────────────────────────────────────────────────
JWT_SECRET="change-me"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-too"
JWT_REFRESH_EXPIRES_IN="30d"

# ── Seed admin ──────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me"

# ── Billing / Stripe ────────────────────────────────────────────────────────
APP_URL="http://localhost:5173"
FREE_DUB_MAX_SECONDS=120

# From the Stripe dashboard (test mode). Required for webhook processing.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe Payment Links (test mode) — read onto the Plan rows by prisma/seed.ts.
STRIPE_LINK_PRO_WEEKLY="https://buy.stripe.com/test_..."
STRIPE_LINK_PRO_MONTHLY="https://buy.stripe.com/test_..."
STRIPE_LINK_PRO_YEARLY="https://buy.stripe.com/test_..."
STRIPE_LINK_STUDIO_WEEKLY="https://buy.stripe.com/test_..."
STRIPE_LINK_STUDIO_MONTHLY="https://buy.stripe.com/test_..."
STRIPE_LINK_STUDIO_YEARLY="https://buy.stripe.com/test_..."
