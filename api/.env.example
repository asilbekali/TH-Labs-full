# # ── Core ────────────────────────────────────────────────────────────────────
# DATABASE_URL="postgresql://neondb_owner:npg_qGHw4Jtka9sF@ep-green-bread-aw8jn8t9.c-12.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# PORT=3001

# # ── Auth (JWT) ──────────────────────────────────────────────────────────────
# JWT_SECRET="change-me"
# JWT_EXPIRES_IN="15m"
# JWT_REFRESH_SECRET="change-me-too"
# JWT_REFRESH_EXPIRES_IN="30d"

# # ── Dubbing pipeline ────────────────────────────────────────────────────────
# # Origin of the FastAPI pipeline, probed by GET /v1/health so the Studio can
# # tell "pipeline asleep" apart from "API down". Optional — leave it unset and
# # health reports pipeline: "not_configured" instead of guessing.
# DUB_API_URL="http://46.224.138.121:8000"

# # ── Seed admin ──────────────────────────────────────────────────────────────
# SEED_ADMIN_EMAIL="admin@example.com"
# SEED_ADMIN_PASSWORD="change-me"

# # ── Billing / Dodo Payments ────────────────────────────────────────────────
# APP_URL="http://localhost:5173"
# FREE_DUB_MAX_SECONDS=120

# # test_mode (default) talks to test.dodopayments.com and takes test cards
# # only. live_mode takes real money.
# DODO_PAYMENTS_ENVIRONMENT="test_mode"

# # Settings → API keys. Optional: without it checkout falls back to static
# # payment links, and cancel / customer portal are unavailable.
# DODO_PAYMENTS_API_KEY="..."

# # Settings → Webhooks, for an endpoint pointed at
# # <this API>/v1/payments/webhook. Required for credits to ever be granted.
# DODO_WEBHOOK_SECRET="whsec_..."

# # One Dodo product per plan. Either a product id or the full payment link;
# # prisma/seed.ts reads these onto the Plan rows.
# DODO_PRODUCT_PRO_WEEKLY="pdt_..."
# DODO_PRODUCT_PRO_MONTHLY="https://checkout.dodopayments.com/buy/pdt_..."
# DODO_PRODUCT_PRO_YEARLY="pdt_..."
# DODO_PRODUCT_STUDIO_WEEKLY="pdt_..."
# DODO_PRODUCT_STUDIO_MONTHLY="pdt_..."
# DODO_PRODUCT_STUDIO_YEARLY="pdt_..."

# # One-time credit packs (optional; see src/payment/credit-packs.ts).
# DODO_PRODUCT_PACK_120="pdt_..."
# DODO_PRODUCT_PACK_240="pdt_..."
# DODO_PRODUCT_PACK_600="pdt_..."
# DODO_PRODUCT_PACK_1500="pdt_..."

# # ── Mail (SMTP / nodemailer) ────────────────────────────────────────────────
# # Optional: without MAIL_USER / MAIL_PASS the app still boots and MailService
# # logs every send instead of delivering it.
# # MAIL_PASS is a Gmail *App Password* (16 chars, no spaces), not the account
# # password — 2FA must be on to generate one.
# MAIL_HOST="smtp.gmail.com"
# MAIL_PORT=465
# MAIL_USER="thethlabs.io@gmail.com"
# MAIL_PASS="your-16-char-app-password"
# MAIL_FROM="TH Labs <thethlabs.io@gmail.com>"

# # ── Audit log (admin panel activity feed) ──────────────────────────────────
# # Record GET reads too. Off by default: polling would drown the feed.
# AUDIT_LOG_READS="false"
# # Days of history kept; a daily 3am cron prunes past this.
# AUDIT_LOG_RETENTION_DAYS=90
