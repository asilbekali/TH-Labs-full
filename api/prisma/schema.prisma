generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Waitlist {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model User {
  id                 Int      @id @default(autoincrement())
  email              String   @unique
  name               String
  password           String
  role               Role     @default(USER)

  // ── Billing & credits (step 05, additive) ──────────────────────────────
  credits            Int      @default(60) // cached balance; CreditEntry ledger is the truth
  freeDubUsed        Boolean  @default(false) // the one free 2-minute dub
  stripeCustomerId   String?  @unique

  subscriptions      Subscription[]
  payments           Payment[]
  creditEntries      CreditEntry[]
  refreshTokens      RefreshToken[]
  handoffCodes       HandoffCode[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  @@index([email])
}

model Admin {
  id                 Int      @id @default(autoincrement())
  email              String   @unique
  name               String
  password           String
  role               Role     @default(ADMIN)
  hashedRefreshToken String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

// ── Billing enums (step 05) ───────────────────────────────────────────────
enum PlanTier {
  FREE
  PRO
  STUDIO
}

enum BillingCycle {
  WEEKLY
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum CreditReason {
  SIGNUP_BONUS
  SUBSCRIPTION_GRANT
  PACK_PURCHASE
  DUB_SPEND
  REFUND
  ADMIN_ADJUSTMENT
}

// Catalog of purchasable plans (seven rows: FREE + PRO/STUDIO × weekly/monthly/yearly).
model Plan {
  id             String       @id @default(cuid())
  tier           PlanTier
  cycle          BillingCycle
  priceCents     Int
  /// Credits handed out by ONE allocation, not the headline number on the
  /// pricing page. For weekly/monthly the two are the same; for yearly the
  /// advertised total is `creditsGranted * grantsPerPeriod`.
  creditsGranted Int
  grantDays      Int // 7 or 30
  /// How many allocations one paid period is worth. 1 for weekly/monthly; 12
  /// for yearly, which Stripe bills once but which drips a month at a time.
  /// The cron stops at this count so a year's credits can't all land early.
  grantsPerPeriod Int         @default(1)
  stripePriceId  String?      @unique
  stripeLinkUrl  String?
  active         Boolean      @default(true)

  subscriptions  Subscription[]

  @@unique([tier, cycle])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               Int
  planId               String
  status               SubscriptionStatus @default(ACTIVE)

  stripeSubscriptionId String?            @unique
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  lastGrantAt          DateTime?
  /// Allocations already handed out for the CURRENT period. Reset to 1 by the
  /// checkout and renewal handlers (both grant immediately); incremented by the
  /// recurring cron, which stops once it reaches plan.grantsPerPeriod.
  grantsIssued         Int                @default(0)

  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 Plan               @relation(fields: [planId], references: [id])
  payments             Payment[]

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([userId, status])
}

model Payment {
  id                    String        @id @default(cuid())
  userId                Int
  subscriptionId        String?

  amountCents           Int
  currency              String        @default("usd")
  status                PaymentStatus @default(PENDING)
  description           String

  stripeSessionId       String?       @unique
  stripePaymentIntentId String?       @unique
  stripeInvoiceId       String?       @unique

  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription          Subscription? @relation(fields: [subscriptionId], references: [id])

  createdAt             DateTime      @default(now())

  @@index([userId, createdAt])
}

// Append-only credit ledger. User.credits is a cached balance; if they ever
// disagree, this table wins.
model CreditEntry {
  id        String       @id @default(cuid())
  userId    Int
  delta     Int // positive grant, negative spend
  balance   Int // running balance after this entry
  reason    CreditReason
  refId     String? // jobId, paymentId, etc.
  note      String?

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@index([userId, createdAt])
}

// Opaque, rotated refresh tokens for the new cookie-based auth flow.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// A single-use ticket that carries a session across an origin boundary.
///
/// The landing page (th-labs.uz) and the Studio (*.modal.run) are different
/// origins, so the session cannot simply follow the user and the tokens
/// themselves must not travel in the redirect URL — a URL lands in browser
/// history, the address bar, and the destination's ingress logs.
///
/// So the redirect carries one of these instead: random, short-lived, and
/// consumed on first use. A copy recovered from a log line is already dead.
///
/// `codeHash` — the SHA-256 of the code, never the code itself, so read access
/// to this table does not yield anything redeemable.
///
/// NOTE: this model was dropped by the billing/auth merge (PR #13) while the
/// migration that creates the table and the controller routes that use it both
/// survived, which is what broke the build. The table already exists in every
/// deployed database; do not add a second migration for it.
model HandoffCode {
  id        Int       @id @default(autoincrement())
  codeHash  String    @unique
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  /// Set by the atomic claim in AuthService.exchangeHandoffCode. Non-null
  /// means spent — rows are kept so a replay is distinguishable from a code
  /// that never existed, and swept later by deleteExpiredCodes.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([expiresAt])
  @@index([userId])
}

/// The catalog of languages a dub can target.
///
/// This list used to live only inside the pipeline process
/// (backend/app/languages.py), so `GET /languages` died whenever the GPU box
/// did — and the Studio's target picker silently fell back to a 14-entry copy
/// hardcoded in the frontend. Holding it here means the catalog is served by
/// the always-on account API and can be corrected without a pipeline deploy.
///
/// `whisper` and `nllb` are the model-specific codes the pipeline needs (ASR
/// and NMT respectively); `code` is the short id the API and UI speak. All
/// three are kept on one row precisely so they cannot drift apart.
model Language {
  id        Int      @id @default(autoincrement())
  code      String   @unique // ISO-639-1 where one exists
  name      String // English display name
  native    String // endonym
  flag      String // emoji flag
  whisper   String // Whisper language code
  nllb      String // NLLB-200 FLORES-200 code
  /// Soft delete. A language the pipeline can no longer handle is deactivated,
  /// not deleted, so existing jobs that reference the code still resolve.
  active    Boolean  @default(true)
  /// Display order in the picker; ties break on name. Lets the common targets
  /// stay at the top without renaming anything.
  sortOrder Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([active, sortOrder])
}

// Stripe webhook idempotency guard — one row per delivered event id.
model WebhookEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  type          String
  processedAt   DateTime @default(now())
}
