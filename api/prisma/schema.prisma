generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// People who left their name and email on the landing page.
///
/// This is the old `Waitlist` table, renamed in place (the data came along) —
/// we stopped framing it as a queue to get in and started framing it as the
/// community you join. Joining still triggers the welcome email; see
/// CommunityService.create.
model Community {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  name     String
  password String
  role     Role   @default(USER)

  // ── Billing & credits (step 05, additive) ──────────────────────────────
  credits        Int     @default(60) // cached balance; CreditEntry ledger is the truth
  freeDubUsed    Boolean @default(false) // the one free 2-minute dub
  /// Dodo Payments customer id (`cus_…`), stamped the first time a payment of
  /// theirs is processed. Lets us open the Dodo customer portal for them.
  dodoCustomerId String? @unique

  subscriptions Subscription[]
  payments      Payment[]
  creditEntries CreditEntry[]
  refreshTokens RefreshToken[]
  handoffCodes  HandoffCode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([email])
}

model Admin {
  id                 Int      @id @default(autoincrement())
  email              String   @unique
  name               String
  password           String
  role               Role     @default(ADMIN)
  hashedRefreshToken String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

// ── Billing enums (step 05) ───────────────────────────────────────────────
enum PlanTier {
  FREE
  PRO
  STUDIO
}

enum BillingCycle {
  WEEKLY
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum CreditReason {
  SIGNUP_BONUS
  SUBSCRIPTION_GRANT
  PACK_PURCHASE
  DUB_SPEND
  REFUND
  ADMIN_ADJUSTMENT
}

// Catalog of purchasable plans (seven rows: FREE + PRO/STUDIO × weekly/monthly/yearly).
model Plan {
  id              String       @id @default(cuid())
  tier            PlanTier
  cycle           BillingCycle
  priceCents      Int
  /// Credits handed out by ONE allocation, not the headline number on the
  /// pricing page. For weekly/monthly the two are the same; for yearly the
  /// advertised total is `creditsGranted * grantsPerPeriod`.
  creditsGranted  Int
  grantDays       Int // 7 or 30
  /// How many allocations one paid period is worth. 1 for weekly/monthly; 12
  /// for yearly, which Dodo bills once but which drips a month at a time.
  /// The cron stops at this count so a year's credits can't all land early.
  grantsPerPeriod Int          @default(1)
  /// The Dodo Payments product this plan is sold as (`pdt_…`). This is how a
  /// webhook is resolved back to a plan, so it must match the product the
  /// checkout was opened for.
  dodoProductId   String?      @unique
  /// Optional static payment link for the same product. Only used when no API
  /// key is configured — with one, checkout sessions are created server-side.
  dodoLinkUrl     String?
  active          Boolean      @default(true)

  subscriptions Subscription[]

  @@unique([tier, cycle])
}

/// One-time credit packs — buying credits outright, with no subscription.
///
/// These used to be a hardcoded list in the API with product ids read from
/// environment variables, which meant selling a new pack was a deploy. They
/// live here instead so an ADMIN can create one, price it, and paste in the
/// Dodo product link from the panel, and the site picks it up on the next
/// request.
model CreditPack {
  id     String @id @default(cuid())
  /// Stable public id (`pack_240`). This is what travels in the checkout
  /// metadata and what the webhook reads back, so renaming one orphans any
  /// checkout already in flight — change the label, not the slug.
  slug   String @unique
  credits    Int
  priceCents Int
  currency   String @default("usd")
  /// Marks the pack the pricing page highlights. Not enforced to be unique;
  /// the page simply highlights whichever rows carry it.
  popular   Boolean @default(false)
  sortOrder Int     @default(0)
  /// Soft delete. A deactivated pack stops being offered but keeps its slug,
  /// so the payment history of everyone who bought one still resolves.
  active    Boolean @default(true)

  /// The Dodo product this pack is sold as, and its checkout link. Either can
  /// be set from the admin panel; the other is derived.
  dodoProductId String? @unique
  dodoLinkUrl   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

model Subscription {
  id     String             @id @default(cuid())
  userId Int
  planId String
  status SubscriptionStatus @default(ACTIVE)

  dodoSubscriptionId   String?   @unique
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean   @default(false)
  lastGrantAt          DateTime?
  /// Allocations already handed out for the CURRENT period. Reset to 1 by the
  /// checkout and renewal handlers (both grant immediately); incremented by the
  /// recurring cron, which stops once it reaches plan.grantsPerPeriod.
  grantsIssued         Int       @default(0)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}

model Payment {
  id             String  @id @default(cuid())
  userId         Int
  subscriptionId String?

  amountCents Int
  currency    String        @default("usd")
  status      PaymentStatus @default(PENDING)
  description String

  dodoPaymentId         String? @unique
  dodoCheckoutSessionId String?
  dodoInvoiceId         String? @unique

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Append-only credit ledger. User.credits is a cached balance; if they ever
// disagree, this table wins.
model CreditEntry {
  id      String       @id @default(cuid())
  userId  Int
  delta   Int // positive grant, negative spend
  balance Int // running balance after this entry
  reason  CreditReason
  refId   String? // jobId, paymentId, etc.
  note    String?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Opaque, rotated refresh tokens for the new cookie-based auth flow.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

/// A single-use ticket that carries a session across an origin boundary.
///
/// The landing page (th-labs.uz) and the Studio (*.modal.run) are different
/// origins, so the session cannot simply follow the user and the tokens
/// themselves must not travel in the redirect URL — a URL lands in browser
/// history, the address bar, and the destination's ingress logs.
///
/// So the redirect carries one of these instead: random, short-lived, and
/// consumed on first use. A copy recovered from a log line is already dead.
///
/// `codeHash` — the SHA-256 of the code, never the code itself, so read access
/// to this table does not yield anything redeemable.
///
/// NOTE: this model was dropped by the billing/auth merge (PR #13) while the
/// migration that creates the table and the controller routes that use it both
/// survived, which is what broke the build. The table already exists in every
/// deployed database; do not add a second migration for it.
model HandoffCode {
  id        Int       @id @default(autoincrement())
  codeHash  String    @unique
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  /// Set by the atomic claim in AuthService.exchangeHandoffCode. Non-null
  /// means spent — rows are kept so a replay is distinguishable from a code
  /// that never existed, and swept later by deleteExpiredCodes.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([expiresAt])
  @@index([userId])
}

