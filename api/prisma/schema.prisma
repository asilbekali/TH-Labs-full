generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// People who left their name and email on the landing page.
///
/// This is the old `Waitlist` table, renamed in place (the data came along) —
/// we stopped framing it as a queue to get in and started framing it as the
/// community you join. Joining still triggers the welcome email; see
/// CommunityService.create.
model Community {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

/// Product feedback left from inside the app (Home → Feedback section).
///
/// Sibling of `Community`: that one is "leave your email on the landing page",
/// this one is "tell us what you think from inside the Studio". They are kept
/// apart on purpose — a community row is a contact to email, a feedback row is
/// a message to read and answer, and merging them would mean the admin panel
/// could not tell a signup from a bug report.
///
/// `userId` is a nullable back-reference rather than a required relation: the
/// section is reachable while signed out, and deleting an account must not
/// delete what that person told us. `email` and `name` are copied in at write
/// time for exactly the same reason the audit log denormalises its actor — the
/// message has to stay attributable after the account is gone.
model Feedback {
  id      Int     @id @default(autoincrement())
  /// Set when the sender was signed in; null for an anonymous submission.
  userId  Int?
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Snapshot of who sent it. Kept even when `userId` is nulled by a deletion.
  name    String
  email   String
  /// Optional one-line subject. The message is the part that matters.
  subject String?
  message String

  /// What kind of message this is, so the panel can triage a crash report
  /// ahead of a feature wish instead of reading a single undifferentiated
  /// inbox.
  kind   FeedbackKind   @default(GENERAL)
  /// 1-5 when the sender rated us, null when they only wrote prose. Not a
  /// required field: demanding a star rating to file a bug report is how you
  /// stop getting bug reports.
  rating Int?

  /// Triage state, moved by an ADMIN from the panel. Nothing is ever deleted
  /// as part of normal triage — `RESOLVED` is the end state, and delete is a
  /// SUPERADMIN-only correction for spam.
  status FeedbackStatus @default(NEW)
  /// Private staff note. Never shown to the sender; the panel labels it so.
  adminNote String?

  /// Where it was sent from (`/`, `/studio`) and the browser that sent it.
  /// Diagnostics for a bug report, not analytics — one line each.
  pagePath  String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([status, createdAt])
  @@index([kind, createdAt])
  @@index([userId])
}

enum FeedbackKind {
  GENERAL
  BUG
  FEATURE
  PRICING
  QUALITY
}

enum FeedbackStatus {
  NEW
  READ
  IN_PROGRESS
  RESOLVED
  SPAM
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  name     String
  password String
  role     Role   @default(USER)

  // ── Billing & credits (step 05, additive) ──────────────────────────────
  /// Cached balance; the CreditEntry ledger is the truth. Defaults to 0 and is
  /// funded by an explicit SIGNUP_BONUS ledger entry at registration (see
  /// UsersService.create) — a bare column default gave every account credits
  /// that no ledger row accounted for, which is exactly the drift
  /// /payments/credits/reconcile exists to report.
  credits        Int     @default(0)
  /// Lemon Squeezy customer id, learned from the first order this account
  /// claims. LS creates the customer itself at checkout, so this is recorded
  /// rather than requested. Not unique: one LS customer is one email, and an
  /// email can only belong to one account here anyway.
  lsCustomerId        String?
  /// When this account last opened a Lemon Squeezy checkout. There is no
  /// webhook, so a buyer who pays and closes the tab is found by polling: the
  /// cron asks LS about every account with a checkout opened in the last day.
  lsCheckoutStartedAt DateTime?

  subscriptions Subscription[]
  payments      Payment[]
  feedback      Feedback[]
  creditEntries CreditEntry[]
  refreshTokens RefreshToken[]
  handoffCodes  HandoffCode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([email])
}

model Admin {
  id                 Int      @id @default(autoincrement())
  email              String   @unique
  name               String
  password           String
  role               Role     @default(ADMIN)
  hashedRefreshToken String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

// ── Billing enums (step 05) ───────────────────────────────────────────────
enum PlanTier {
  FREE
  PRO
  STUDIO
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum CreditReason {
  SIGNUP_BONUS
  SUBSCRIPTION_GRANT
  PACK_PURCHASE
  DUB_SPEND
  REFUND
  ADMIN_ADJUSTMENT
}

// Catalog of purchasable plans (five rows: FREE + PRO/STUDIO × monthly/yearly).
model Plan {
  id              String       @id @default(cuid())
  tier            PlanTier
  cycle           BillingCycle
  priceCents      Int
  /// Credits handed out by ONE allocation, not the headline number on the
  /// pricing page. For monthly the two are the same; for yearly the
  /// advertised total is `creditsGranted * grantsPerPeriod`.
  creditsGranted  Int
  grantDays       Int // 30
  /// How many allocations one paid period is worth. 1 for monthly; 12 for
  /// yearly, which is charged once but drips a month at a time. The cron stops
  /// at this count so a year's credits can't all land early.
  grantsPerPeriod Int          @default(1)
  /// The Lemon Squeezy share link the Buy button opens
  /// (`https://<store>.lemonsqueezy.com/checkout/buy/<uuid>`). Pasted in from
  /// the admin panel; empty means this plan cannot be bought yet, which the
  /// pricing page reports rather than hiding.
  checkoutUrl String?
  /// The Lemon Squeezy VARIANT that link sells. This is what a paid order is
  /// matched back to, and it is AUTHORITATIVE: LS reports it on the order, the
  /// buyer cannot change it. Without it a paid order cannot be credited.
  lsVariantId String?      @unique
  active      Boolean      @default(true)

  subscriptions Subscription[]

  @@unique([tier, cycle])
}

/// One-time credit packs — buying credits outright, with no subscription.
///
/// These used to be a hardcoded list in the API with product ids read from
/// environment variables, which meant selling a new pack was a deploy. They
/// live here instead so an ADMIN can create one, set its credits and price and
/// paste in the Lemon Squeezy checkout link from the panel, and the site picks it up on
/// the next request.
model CreditPack {
  id     String @id @default(cuid())
  /// Stable public id (`pack_240`). It travels to Lemon Squeezy in the
  /// checkout's custom data, so renaming one is confusing in the LS dashboard
  /// and the history — change the label, not the slug.
  slug   String @unique
  credits    Int
  priceCents Int
  currency   String @default("usd")
  /// Marks the pack the pricing page highlights. Not enforced to be unique;
  /// the page simply highlights whichever rows carry it.
  popular   Boolean @default(false)
  sortOrder Int     @default(0)
  /// Soft delete. A deactivated pack stops being offered but keeps its slug,
  /// so the payment history of everyone who bought one still resolves.
  active    Boolean @default(true)

  /// The Lemon Squeezy share link the Buy button opens, and the variant it
  /// sells. Same contract as Plan: a paid order is matched on the variant.
  checkoutUrl String?
  lsVariantId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

model Subscription {
  id     String             @id @default(cuid())
  userId Int
  planId String
  status SubscriptionStatus @default(ACTIVE)

  /// Lemon Squeezy's subscription id. What the renewal poll asks LS about:
  /// each paid renewal invoice on it opens a new period and grants credits.
  lsSubscriptionId     String?   @unique
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean   @default(false)
  lastGrantAt          DateTime?
  /// Allocations already handed out for the CURRENT period. Set to 1 by the
  /// claim (which grants immediately); incremented by the recurring cron, which
  /// stops once it reaches plan.grantsPerPeriod.
  grantsIssued         Int       @default(0)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}

model Payment {
  id             String  @id @default(cuid())
  userId         Int
  subscriptionId String?

  amountCents Int
  currency    String        @default("usd")
  status      PaymentStatus @default(PENDING)
  description String

  /// The Lemon Squeezy order a purchase was credited from. UNIQUE, and that
  /// constraint is the idempotency guarantee: the row is written in the same
  /// transaction as the grant, so however many times an order is seen — the
  /// success page, a reload, the cron — it pays out once.
  lsOrderId         String? @unique
  /// The order's public UUID, so a row can be found in the LS dashboard.
  lsOrderIdentifier String? @unique
  /// The subscription invoice a RENEWAL was credited from. Same guarantee as
  /// lsOrderId, for the charges LS makes after the first one.
  lsInvoiceId       String? @unique

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Append-only credit ledger. User.credits is a cached balance; if they ever
// disagree, this table wins.
model CreditEntry {
  id      String       @id @default(cuid())
  userId  Int
  delta   Int // positive grant, negative spend
  balance Int // running balance after this entry
  reason  CreditReason
  refId   String? // jobId, paymentId, etc.
  note    String?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Opaque, rotated refresh tokens for the new cookie-based auth flow.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

/// A single-use ticket that carries a session across an origin boundary.
///
/// The landing page (th-labs.uz) and the Studio (*.modal.run) are different
/// origins, so the session cannot simply follow the user and the tokens
/// themselves must not travel in the redirect URL — a URL lands in browser
/// history, the address bar, and the destination's ingress logs.
///
/// So the redirect carries one of these instead: random, short-lived, and
/// consumed on first use. A copy recovered from a log line is already dead.
///
/// `codeHash` — the SHA-256 of the code, never the code itself, so read access
/// to this table does not yield anything redeemable.
///
/// NOTE: this model was dropped by the billing/auth merge (PR #13) while the
/// migration that creates the table and the controller routes that use it both
/// survived, which is what broke the build. The table already exists in every
/// deployed database; do not add a second migration for it.
model HandoffCode {
  id        Int       @id @default(autoincrement())
  codeHash  String    @unique
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  /// Set by the atomic claim in AuthService.exchangeHandoffCode. Non-null
  /// means spent — rows are kept so a replay is distinguishable from a code
  /// that never existed, and swept later by deleteExpiredCodes.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([expiresAt])
  @@index([userId])
}

