/// The catalog of languages a dub can target.
///
/// This list used to live only inside the pipeline process
/// (backend/app/languages.py), so `GET /languages` died whenever the GPU box
/// did — and the Studio's target picker silently fell back to a 14-entry copy
/// hardcoded in the frontend. Holding it here means the catalog is served by
/// the always-on account API and can be corrected without a pipeline deploy.
///
/// `whisper` and `nllb` are the model-specific codes the pipeline needs (ASR
/// and NMT respectively); `code` is the short id the API and UI speak. All
/// three are kept on one row precisely so they cannot drift apart.
model Language {
  id        Int     @id @default(autoincrement())
  code      String  @unique // ISO-639-1 where one exists
  name      String // English display name
  native    String // endonym
  flag      String // emoji flag
  whisper   String // Whisper language code
  nllb      String // NLLB-200 FLORES-200 code
  /// Soft delete. A language the pipeline can no longer handle is deactivated,
  /// not deleted, so existing jobs that reference the code still resolve.
  active    Boolean @default(true)
  /// Display order in the picker; ties break on name. Lets the common targets
  /// stay at the top without renaming anything.
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([active, sortOrder])
}

/// Append-only activity log — who did what, when, and what came of it.
///
/// Written by AuditInterceptor for every state-changing request (and for the
/// notable reads: checkout, the customer portal, admin pages), so the admin
/// panel can show a live feed rather than staff having to read server logs.
///
/// Deliberately denormalised: `actorEmail` and `actorRole` are copied in at
/// write time rather than joined from User. An audit trail has to stay true
/// about who did something even after that account is renamed or deleted, and
/// `actorId` is nullable precisely so a deleted user does not take their
/// history with them.
model AuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  /// Null for an anonymous caller (a failed login, a provider webhook).
  actorId    Int?
  actorEmail String?
  actorRole  Role?

  /// Stable name for what happened (`auth.login`, `billing.plan.update`).
  /// The panel groups and filters on this, so it must not embed ids.
  action     String
  method     String
  path       String
  statusCode Int
  durationMs Int
  /// False when the request failed — the panel's red rows.
  success    Boolean

  /// WHAT was acted on — the other half of "who did what to whom".
  ///
  /// `targetLabel` is resolved and copied in at write time (an email, a
  /// `PRO/MONTHLY`, a pack slug) so the feed reads "changed the role of
  /// ada@example.com" rather than "changed the role of user 42". Like the
  /// actor fields it is a snapshot: renaming or deleting the target later
  /// must not rewrite what the log says was done to it.
  targetType  String?
  targetId    String?
  targetLabel String?
  /// One human sentence for the feed, with the label already substituted.
  summary   String?
  /// Request/response detail, with every credential-shaped field redacted.
  meta      Json?

  ip        String?
  userAgent String?

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([success, createdAt])
  @@index([targetType, targetId, createdAt])
}

// Webhook idempotency guard — one row per delivered event id. For Dodo
// Payments that id is the `webhook-id` header (Standard Webhooks), which is
// stable across the provider's retries of the same event.
model WebhookEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  type        String
  processedAt DateTime @default(now())
}
