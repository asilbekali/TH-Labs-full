generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Waitlist {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model User {
  id                 Int      @id @default(autoincrement())
  email              String   @unique
  name               String
  password           String
  role               Role     @default(USER)

  // ── Billing & credits (step 05, additive) ──────────────────────────────
  credits            Int      @default(60) // cached balance; CreditEntry ledger is the truth
  freeDubUsed        Boolean  @default(false) // the one free 2-minute dub
  stripeCustomerId   String?  @unique

  subscriptions      Subscription[]
  payments           Payment[]
  creditEntries      CreditEntry[]
  refreshTokens      RefreshToken[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  @@index([email])
}

model Admin {
  id                 Int      @id @default(autoincrement())
  email              String   @unique
  name               String
  password           String
  role               Role     @default(ADMIN)
  hashedRefreshToken String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

// ── Billing enums (step 05) ───────────────────────────────────────────────
enum PlanTier {
  FREE
  PRO
  STUDIO
}

enum BillingCycle {
  WEEKLY
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum CreditReason {
  SIGNUP_BONUS
  SUBSCRIPTION_GRANT
  PACK_PURCHASE
  DUB_SPEND
  REFUND
  ADMIN_ADJUSTMENT
}

// Catalog of purchasable plans (seven rows: FREE + PRO/STUDIO × weekly/monthly/yearly).
model Plan {
  id             String       @id @default(cuid())
  tier           PlanTier
  cycle          BillingCycle
  priceCents     Int
  creditsGranted Int
  grantDays      Int // 7 or 30
  stripePriceId  String?      @unique
  stripeLinkUrl  String?
  active         Boolean      @default(true)

  subscriptions  Subscription[]

  @@unique([tier, cycle])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               Int
  planId               String
  status               SubscriptionStatus @default(ACTIVE)

  stripeSubscriptionId String?            @unique
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  lastGrantAt          DateTime?

  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 Plan               @relation(fields: [planId], references: [id])
  payments             Payment[]

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([userId, status])
}

model Payment {
  id                    String        @id @default(cuid())
  userId                Int
  subscriptionId        String?

  amountCents           Int
  currency              String        @default("usd")
  status                PaymentStatus @default(PENDING)
  description           String

  stripeSessionId       String?       @unique
  stripePaymentIntentId String?       @unique
  stripeInvoiceId       String?       @unique

  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription          Subscription? @relation(fields: [subscriptionId], references: [id])

  createdAt             DateTime      @default(now())

  @@index([userId, createdAt])
}

// Append-only credit ledger. User.credits is a cached balance; if they ever
// disagree, this table wins.
model CreditEntry {
  id        String       @id @default(cuid())
  userId    Int
  delta     Int // positive grant, negative spend
  balance   Int // running balance after this entry
  reason    CreditReason
  refId     String? // jobId, paymentId, etc.
  note      String?

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@index([userId, createdAt])
}

// Opaque, rotated refresh tokens for the new cookie-based auth flow.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Stripe webhook idempotency guard — one row per delivered event id.
model WebhookEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  type          String
  processedAt   DateTime @default(now())
}
