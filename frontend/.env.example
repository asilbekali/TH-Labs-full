# TH-Labs Studio — frontend environment.
#
#   cp .env.example .env.local
#
# Vite only exposes variables prefixed with VITE_, and it INLINES them at build
# time. Changing any of these in production means rebuilding, not restarting.
#
# Because they are inlined into the JS bundle, everything here is public. Never
# put a Stripe secret key (sk_…), a JWT secret, or a database URL in this file —
# those belong to the API server only.

# ── Account / billing API (NestJS, Swagger at <host>/docs) ──────────────────
# The CRUD API behind auth, users and payments. Must include the /v1 suffix.
#
#   local dev     http://localhost:3001/v1
#   by IP         http://192.0.2.10:3001/v1
#   production    https://th-labs.uz/v1
#
# Leave unset ONLY in local dev, where vite.config.ts proxies /v1 to :3001.
# Unset in a deployed build makes every /v1 call hit the SPA origin and fail.
VITE_ACCOUNT_API=http://localhost:3001/v1

# ── Dubbing API (FastAPI) ───────────────────────────────────────────────────
# Health, languages and the /jobs pipeline. Include the /api suffix.
# Unset falls back to the relative /api, which the Vite dev proxy and a
# single-origin reverse proxy both resolve correctly.
VITE_DUB_API=/api

# ── Stripe ──────────────────────────────────────────────────────────────────
# PUBLISHABLE key only (pk_live_… / pk_test_…). It is safe in the bundle by
# design. Checkout itself is a Stripe-hosted Payment Link the API hands back
# from GET /v1/payments/checkout, so the browser never touches a secret key.
# Unset simply disables the upgrade buttons with an explanatory message.
VITE_STRIPE_PUBLISHABLE_KEY=
