# ── Python / backend ──
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
backend/.env
backend/data/uploads/*
backend/data/outputs/*
backend/data/assets/*
!backend/data/**/.gitkeep

# ── ML models & weights (download per setup; too large for git) ──
backend/models/
*.pth
*.ckpt
*.pt
*.safetensors
*.onnx

# ── Generated / bundled media (regenerated at runtime) ──
backend/app/assets/*.mp4
backend/app/assets/*.wav
backend/app/assets/*.mp3
backend/app/assets/*.m4a

# ── Node / frontend ──
node_modules/
frontend/dist/
frontend/.vite/
*.local

# ── Misc ──
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
