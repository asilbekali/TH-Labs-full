# Copy to .env — `docker compose` reads that file automatically from this
# directory. .env is gitignored; never commit real secrets.
#
#   cp .env.example .env

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=thlabs
POSTGRES_DB=thlabs
# Required. Only ever exists in this file and the container.
POSTGRES_PASSWORD=

# ── JWT ─────────────────────────────────────────────────────────────────────
# Both required — compose will refuse to start without them, because the app
# itself would otherwise silently fall back to 'dev-secret'.
# Generate each with:  openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# The Studio needs this exact JWT_SECRET to verify the tokens this API issues.
# See deploy/docker/README.md.
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Host port mappings ──────────────────────────────────────────────────────
# Change if something already owns these locally.
API_PORT=3000
POSTGRES_PORT=5432

# ── Seeding (optional) ──────────────────────────────────────────────────────
# Read only by `yarn prisma:seed`, which upserts a SUPERADMIN. prisma/seed.ts
# defaults to admin@thlabs.dev / Admin123! when these are unset — fine for a
# local database, never acceptable anywhere reachable.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
