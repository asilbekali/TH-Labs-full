# Copy to .env — `docker compose` reads that file automatically from this
# directory. .env is gitignored; never commit real secrets.
#
#   cp .env.example .env

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=thlabs
POSTGRES_DB=thlabs
# Required. Only ever exists in this file and the container.
POSTGRES_PASSWORD=

# ── JWT ─────────────────────────────────────────────────────────────────────
# Both required — compose will refuse to start without them, because the app
# itself would otherwise silently fall back to 'dev-secret'.
# Generate each with:  openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# The Studio needs this exact JWT_SECRET to verify the tokens this API issues.
# On Modal it is supplied as a Secret, not an env var — create it once with:
#
#   modal secret create th-labs-jwt TH_LABS_JWT_SECRET=<the same JWT_SECRET>
#
# Rotating JWT_SECRET here without updating that Secret signs every Studio
# request out; they must change together. See deploy/modal/modal_app.py.
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ────────────────────────────────────────────────────────────────────
# Browser origins allowed to call this API directly. Comma-separated; unset
# uses the defaults in src/main.ts (the Studio's Modal URL + Vite dev ports).
#
# The Studio needs to be here because it redeems handoff codes and refreshes
# from the browser, cross-origin. The landing page does NOT — it only ever
# calls its own Next.js route handlers, which reach this API server-side.
CORS_ORIGINS=

# ── Host port mappings ──────────────────────────────────────────────────────
# Change if something already owns these locally.
API_PORT=3000
POSTGRES_PORT=5432

# ── Seeding ─────────────────────────────────────────────────────────────────
# Deliberately NOT configured here. The seed runs inside the container, and
# variables in this file are only injected into the service's environment at
# start — putting them here would look like it worked while prisma/seed.ts

# silently fell back to admin@thlabs.dev / Admin123!.
#
# Pass them on the command instead, so the values are always explicit:
#   docker compose exec \
#     -e SEED_ADMIN_EMAIL=you@example.com \
#     -e SEED_ADMIN_PASSWORD='<strong password>' \
#     api yarn prisma:seed

# ── Lemon Squeezy ───────────────────────────────────────────────────────────
# Payments are Lemon Squeezy share links plus reads of the LS API. No webhook.
#
# How a purchase becomes credits:
#   1. The Buy button opens the plan's share link with the account's email
#      prefilled (that email is how the order is found again).
#   2. The customer pays on lemonsqueezy.com.
#   3. The API asks LS for the paid orders filed under that email and credits
#      each new one, matched on the order's VARIANT id — once, keyed on the
#      order id. It asks when the buyer returns to /plans/success, and every
#      5 minutes for a day after a checkout was opened, so closing the tab
#      loses nothing. Subscription renewals are polled hourly the same way.
#
# The links and variant ids live in the catalog (admin panel; the seed fills
# the starting ones). Nothing to set here for them.
#
# Set each LS product's redirect / confirmation button link to
# ${APP_URL}/plans/success so buyers come straight back. Optional — the cron
# credits them anyway.
#
# LEMONSQUEEZY_API_KEY is the critical one: without it no purchase can be
# verified, so Buy buttons 503 rather than taking money that cannot be
# credited. Keys are per-mode — a TEST-mode key sees only test orders — so it
# must match the mode of the links in the catalog (currently TEST mode).
# LEMONSQUEEZY_STORE_ID is only needed if the key can see more than one store.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=

# ── Studio billing ──────────────────────────────────────────────────────────
# Base URL of the NestJS account API, INCLUDING /v1. When set, the dubbing API
# checks and charges credits server-side before running a job, so the Studio's
# credit gate cannot be bypassed by posting straight to /api/jobs. Leave unset
# locally (there is no account API to ask) — see api/PAYMENTS.md.
TH_LABS_ACCOUNT_API_URL=
