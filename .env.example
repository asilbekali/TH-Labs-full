# Copy to .env — `docker compose` reads that file automatically from this
# directory. .env is gitignored; never commit real secrets.
#
#   cp .env.example .env

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=thlabs
POSTGRES_DB=thlabs
# Required. Only ever exists in this file and the container.
POSTGRES_PASSWORD=

# ── JWT ─────────────────────────────────────────────────────────────────────
# Both required — compose will refuse to start without them, because the app
# itself would otherwise silently fall back to 'dev-secret'.
# Generate each with:  openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# The Studio needs this exact JWT_SECRET to verify the tokens this API issues.
# On Modal it is supplied as a Secret, not an env var — create it once with:
#
#   modal secret create th-labs-jwt TH_LABS_JWT_SECRET=<the same JWT_SECRET>
#
# Rotating JWT_SECRET here without updating that Secret signs every Studio
# request out; they must change together. See deploy/modal/modal_app.py.
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ────────────────────────────────────────────────────────────────────
# Browser origins allowed to call this API directly. Comma-separated; unset
# uses the defaults in src/main.ts (the Studio's Modal URL + Vite dev ports).
#
# The Studio needs to be here because it redeems handoff codes and refreshes
# from the browser, cross-origin. The landing page does NOT — it only ever
# calls its own Next.js route handlers, which reach this API server-side.
CORS_ORIGINS=

# ── Host port mappings ──────────────────────────────────────────────────────
# Change if something already owns these locally.
API_PORT=3000
POSTGRES_PORT=5432

# ── Seeding ─────────────────────────────────────────────────────────────────
# Deliberately NOT configured here. The seed runs inside the container, and
# variables in this file are only injected into the service's environment at
# start — putting them here would look like it worked while prisma/seed.ts
# silently fell back to admin@thlabs.dev / Admin123!.
#
# Pass them on the command instead, so the values are always explicit:
#   docker compose exec \
#     -e SEED_ADMIN_EMAIL=you@example.com \
#     -e SEED_ADMIN_PASSWORD='<strong password>' \
#     api yarn prisma:seed
