# Production environment for /srv/th-labs/.env on the server.
# Copy this file there and fill it in. It is the only place the database
# password and JWT secrets exist — it is never committed and never baked into
# the image.
#
#   chmod 600 /srv/th-labs/.env

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=thlabs
POSTGRES_DB=thlabs
# Required.
POSTGRES_PASSWORD=

# ── JWT ─────────────────────────────────────────────────────────────────────
# Both required — compose refuses to start without them.
#   openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=

JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Origins ─────────────────────────────────────────────────────────────────
# Comma-separated list of browser origins allowed to call this API. The Studio
# runs on Modal — a different origin — and redeems its handoff code and
# refreshes from the BROWSER, so its origin MUST be here or sign-in there fails
# with an opaque CORS error. Leave unset to use the defaults in api/src/main.ts.
CORS_ORIGINS=https://th-labs.uz,https://www.th-labs.uz,https://aytingchi.uz,https://www.aytingchi.uz,https://isoqovjorabek2--th-labs-dubbing-web.modal.run
APP_URL=https://th-labs.uz

# ── Dodo Payments ───────────────────────────────────────────────────────────
# The API boots fine without these, which is exactly why a broken payment
# setup is quiet. What breaks: the webhook rejects every event (and the webhook
# is the ONLY thing that grants credits), and /payments/checkout 400s because
# the Plan rows have no product. Users can browse plans and pay nothing.
#
# API key — Dashboard > Settings > API keys. Never commit it; this file lives
# only at /srv/th-labs/.env with chmod 600.
DODO_PAYMENTS_API_KEY=

# test_mode talks to test.dodopayments.com and takes test cards only.
# A production box wants live_mode — with a live key and live products.
DODO_PAYMENTS_ENVIRONMENT=live_mode

# Signing secret for the webhook endpoint. This is NOT an API key — create the
# endpoint first at Dashboard > Settings > Webhooks:
#
#   URL     https://th-labs.uz/v1/payments/webhook
#   events  payment.succeeded, payment.failed,
#           subscription.active, subscription.renewed, subscription.updated,
#           subscription.plan_changed, subscription.past_due,
#           subscription.on_hold, subscription.paused, subscription.unpaused,
#           subscription.cancelled, subscription.expired, subscription.failed
#
# Dodo then shows the signing secret. That goes here.
DODO_WEBHOOK_SECRET=

# ── Dodo products ───────────────────────────────────────────────────────────
# One per paid plan row, from Dashboard > Products. Paste EITHER the product id
# (pdt_…) OR the whole payment link — both are accepted.
#
# The API opens a checkout session stamped with the paying user's id, and the
# webhook reads it back to decide whose credits to grant. A payment that
# arrives with neither that metadata nor a matching account email is logged and
# IGNORED.
#
# Read by prisma/seed.ts at SEED time, not on boot. After changing one:
#   docker compose exec api yarn prisma:seed
# The two weekly tiers have no product in the Dodo account yet — leave them
# empty and the Plans page disables those buttons.
DODO_PRODUCT_PRO_WEEKLY=
DODO_PRODUCT_PRO_MONTHLY=pdt_0NndJfgNJFC1NXWXYIMYH
DODO_PRODUCT_PRO_YEARLY=pdt_0NoP2MFu7lderQf7S3X3E
DODO_PRODUCT_STUDIO_WEEKLY=
DODO_PRODUCT_STUDIO_MONTHLY=pdt_0NoP1dy9noxnvH4MFUikv
DODO_PRODUCT_STUDIO_YEARLY=pdt_0NoP2luLCojMj1yC4n3tG

# One-time credit packs. Optional — an unset one hides that pack's buy button.
# Price each Dodo product to match api/src/payment/credit-packs.ts.
# Starter $1.19 / Creator $4.99 / Pro $17.99. None exist in Dodo yet, so all
# three buy buttons stay hidden until they do.
DODO_PRODUCT_PACK_100=
DODO_PRODUCT_PACK_500=
DODO_PRODUCT_PACK_2000=

# Cap on the single free dub each new user gets, in seconds.
FREE_DUB_MAX_SECONDS=120

# ── Deployment ──────────────────────────────────────────────────────────────
# Only used for the banner the app prints on boot.
PUBLIC_HOST=aytingchi.uz

# Pin to a specific build to roll back; leave unset to track latest.
#   API_IMAGE=ghcr.io/asilbekali/th-labs-full/api:sha-<commit>
# API_IMAGE=
