# Production environment for /srv/th-labs/.env on the server.
# Copy this file there and fill it in. It is the only place the database
# password and JWT secrets exist — it is never committed and never baked into
# the image.
#
#   chmod 600 /srv/th-labs/.env

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=thlabs
POSTGRES_DB=thlabs
# Required.
POSTGRES_PASSWORD=

# ── JWT ─────────────────────────────────────────────────────────────────────
# Both required — compose refuses to start without them.
#   openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=

JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Deployment ──────────────────────────────────────────────────────────────
# Only used for the banner the app prints on boot.
PUBLIC_HOST=aytingchi.uz

# Pin to a specific build to roll back; leave unset to track latest.
#   API_IMAGE=ghcr.io/asilbekali/th-labs-full/api:sha-<commit>
# API_IMAGE=
