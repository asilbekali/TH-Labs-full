# /etc/caddy/Caddyfile
#
# One domain, two upstreams, split by path:
#
#   aytingchi.uz/v1/*   -> NestJS account API   (127.0.0.1:3000)
#   aytingchi.uz/docs*  -> its Swagger UI
#   aytingchi.uz/*      -> Next.js landing page (127.0.0.1:3001)
#
# The API is exposed publicly because the Studio on Modal has to reach it to
# check a user's quota. The landing page does NOT need it public — lib/backend.ts
# calls the API over the Docker network — so if the Studio ever stops needing
# direct access, the /v1 and /docs handles can be dropped and the API becomes
# entirely internal.
#
# Naming the hosts is what makes Caddy request a certificate for them. It then
# handles the ACME challenge, the HTTP->HTTPS redirect, and renewal by itself.
#
# Do NOT add a `redir https://{host}{uri}` catch-all on :80. Caddy's automatic
# HTTPS already redirects, and it exempts /.well-known/acme-challenge/ so
# Let's Encrypt can validate. A hand-written catch-all shadows that path, the
# challenge gets a 308 to an endpoint with no certificate yet, validation
# fails, and no certificate is ever issued — which is exactly the state this
# server was found in.

aytingchi.uz, www.aytingchi.uz {
	# Longest-matching handle wins, so these are evaluated before the catch-all
	# below regardless of order.
	handle /v1/* {
		reverse_proxy localhost:3000
	}

	# Swagger. Publicly readable, which is how the current server already runs;
	# comment this block out if the API surface should not be advertised.
	handle /docs* {
		reverse_proxy localhost:3000
	}

	handle {
		reverse_proxy localhost:3001
	}

	encode gzip zstd

	log {
		output file /var/log/caddy/aytingchi.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
