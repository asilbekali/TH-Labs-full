# A site block to ADD to /opt/solpro/Caddyfile on the server.
#
# ─────────────────────────────────────────────────────────────────────────────
#  That file is the live config for solpra.uz. Append this block; do not
#  replace the file. It is bind-mounted read-only into solpro-caddy-1, so edit
#  it on the host and reload — see deploy/server/README.md.
# ─────────────────────────────────────────────────────────────────────────────
#
# Upstreams are Docker service aliases, not host ports, matching how the
# existing solpra.uz block reaches `solpra:4000`. The TH-LABS stack joins
# solpro_default so Caddy can resolve these names, which means nothing of ours
# publishes a host port — the only way in is through Caddy.
#
# The aliases are prefixed `thlabs-` so they cannot collide with solpro's own
# service names (solpra, caddy, postgres, backup) on the shared network.
#
#   /v1/*   -> NestJS account API   (thlabs-api:3000)
#   /docs*  -> its Swagger UI
#   /*      -> Next.js landing page (thlabs-web:3000)
#
# The landing page does not reach the API through Caddy — lib/backend.ts calls
# it over the internal network. /v1 is published because the Studio on Modal
# needs it, and that is now load-bearing rather than incidental: the Studio is
# a different origin with no session of its own, so it reaches this API from
# the BROWSER to redeem its one-time handoff code (POST /v1/auth/handoff/
# exchange) and to refresh afterwards. Remove this handle and a user who signs
# in on the landing page arrives at a Studio that cannot log them in.
#
# Because those calls are cross-origin, the API's CORS allowlist must name the
# Studio's origin — see CORS_ORIGINS in docker-compose.yml and the defaults in
# api/src/main.ts.
#
# Two domains, one block. th-labs.uz and aytingchi.uz serve identical content —
# deliberately no redirect between them, so both are equally live. Caddy issues
# a certificate per hostname on its own; the only prerequisite is that all four
# names already resolve to this server, or the ACME challenge fails for the ones
# that do not. Keeping them in a single block rather than two is what stops the
# handle blocks and headers below from drifting apart.

# ── TH-LABS ───────────────────────────────────────────────────────────────
aytingchi.uz, www.aytingchi.uz, th-labs.uz, www.th-labs.uz {
	# Longest-matching handle wins, independent of ordering.
	handle /v1/* {
		reverse_proxy thlabs-api:3000
	}

	# Swagger, publicly readable — matching how the old server ran. Delete
	# this block if the API surface should not be advertised.
	handle /docs* {
		reverse_proxy thlabs-api:3000
	}

	handle {
		reverse_proxy thlabs-web:3000
	}

	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
}
